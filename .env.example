# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Sheets Credentials (JSON строка)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Google Spreadsheet ID (из URL таблицы)
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Название листа в таблице (по умолчанию: Receipts)
GOOGLE_WORKSHEET_NAME=Receipts

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO